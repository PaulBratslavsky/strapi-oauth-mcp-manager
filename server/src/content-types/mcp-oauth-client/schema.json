{
  "kind": "collectionType",
  "collectionName": "mcp_oauth_clients",
  "info": {
    "singularName": "mcp-oauth-client",
    "pluralName": "mcp-oauth-clients",
    "displayName": "MCP OAuth Client",
    "description": "OAuth clients allowed to connect to the Strapi MCP server"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "clientId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "clientSecret": {
      "type": "string",
      "private": true
    },
    "redirectUris": {
      "type": "json",
      "required": true
    },
    "tokenEndpointAuthMethod": {
      "type": "enumeration",
      "enum": ["client_secret_basic", "client_secret_post", "none"],
      "default": "client_secret_post",
      "required": true
    },
    "registrationType": {
      "type": "enumeration",
      "enum": ["manual", "dynamic"],
      "default": "manual",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
