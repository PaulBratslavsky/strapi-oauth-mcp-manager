{
  "kind": "collectionType",
  "collectionName": "mcp_oauth_grants",
  "info": {
    "singularName": "mcp-oauth-token",
    "pluralName": "mcp-oauth-tokens",
    "displayName": "MCP OAuth Grant",
    "description": "An authorized MCP client session, backed by an admin token"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "accessTokenHash": {
      "type": "string",
      "required": true,
      "unique": true,
      "private": true
    },
    "refreshTokenHash": {
      "type": "string",
      "required": true,
      "unique": true,
      "private": true
    },
    "previousRefreshTokenHash": {
      "type": "string",
      "private": true
    },
    "rotatedAt": {
      "type": "datetime"
    },
    "clientId": {
      "type": "string",
      "required": true
    },
    "adminUserId": {
      "type": "integer",
      "required": true
    },
    "adminTokenId": {
      "type": "integer",
      "required": true
    },
    "ownsAdminToken": {
      "type": "boolean",
      "default": false
    },
    "adminKeyHash": {
      "type": "string",
      "private": true
    },
    "scope": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "expiresAt": {
      "type": "datetime",
      "required": true
    },
    "refreshExpiresAt": {
      "type": "datetime",
      "required": true
    },
    "lastUsedAt": {
      "type": "datetime"
    }
  }
}
