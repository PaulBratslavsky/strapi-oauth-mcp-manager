{
  "kind": "collectionType",
  "collectionName": "mcp_oauth_codes",
  "info": {
    "singularName": "mcp-oauth-code",
    "pluralName": "mcp-oauth-codes",
    "displayName": "MCP OAuth Code",
    "description": "Short-lived OAuth authorization codes"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "codeHash": {
      "type": "string",
      "required": true,
      "unique": true,
      "private": true
    },
    "clientId": {
      "type": "string",
      "required": true
    },
    "adminUserId": {
      "type": "integer",
      "required": true
    },
    "redirectUri": {
      "type": "text",
      "required": true
    },
    "codeChallenge": {
      "type": "string"
    },
    "codeChallengeMethod": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "expiresAt": {
      "type": "datetime",
      "required": true
    },
    "adminTokenId": {
      "type": "integer"
    }
  }
}
