{
  "name": "strapi-oauth-mcp-manager",
  "version": "1.0.0",
  "description": "OAuth 2.1 authorization server for Strapi's official MCP server (/mcp). Lets Claude, ChatGPT, and other MCP clients connect with a Strapi admin login instead of a pasted token.",
  "keywords": [
    "strapi",
    "plugin",
    "oauth",
    "oauth2",
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "claude",
    "authentication",
    "ai",
    "admin-token",
    "pkce"
  ],
  "license": "MIT",
  "author": "Paul Bratslavsky <paul.bratslavsky@strapi.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaulBratslavsky/strapi-oauth-mcp-manager"
  },
  "homepage": "https://github.com/PaulBratslavsky/strapi-oauth-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/PaulBratslavsky/strapi-oauth-mcp-manager/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "test:ts:back": "run -T tsc -p server/tsconfig.json",
    "test:e2e": "node test/e2e/oauth-flow.mjs && node test/e2e/admin-clients.mjs && node test/e2e/users.mjs && node test/e2e/client-token.mjs",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "prepublishOnly": "npm test && npm run verify"
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0-rc.30",
    "@strapi/icons": "^2.0.0-rc.30"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.4.0",
    "@strapi/strapi": "^5.53.0",
    "@strapi/typescript-utils": "^5.53.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "styled-components": "^6.1.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "styled-components": "^6.1.19"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "strapi-oauth-mcp-manager",
    "displayName": "MCP OAuth",
    "description": "OAuth 2.1 sign-in for Strapi's built-in MCP server"
  }
}
